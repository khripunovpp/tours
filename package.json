{
  "name": "tours",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @tours/demo dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm --filter @tours/demo build",
    "preview": "pnpm --filter @tours/demo preview",
    "dev:react": "pnpm --filter @tours/demo-react dev",
    "dev:vue": "pnpm --filter @tours/demo-vue dev",
    "dev:svelte": "pnpm --filter @tours/demo-svelte dev",
    "dev:solid": "pnpm --filter @tours/demo-solid dev",
    "dev:angular": "pnpm --filter @tours/demo-angular dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "echo \"(no tests yet — added at the end of M0)\"",
    "build:lib": "node scripts/build-lib.mjs",
    "build:wp": "node scripts/build-wp.mjs",
    "build:ext": "pnpm --filter @tours/authoring-extension build",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "wp:clean": "wp-env clean all",
    "wp:destroy": "wp-env destroy"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
