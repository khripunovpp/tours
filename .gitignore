# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output (the root /dist holds committed library bundles — kept on purpose)
build/
*.tsbuildinfo
demo/dist/
demos/*/dist/
demos/*/dist-angular/
# Assembled (derived) artifacts — sources live in packages/*
dist/wordpress-plugin/
dist/extension/
# packages/{schema,core,editor}/dist IS committed — git install ships the tree
# as-is, so the built output has to be in the repo. The extension is not an
# installable package, so its build output stays out.
packages/authoring-extension/dist/

# Extension build artifacts
*.zip
*.crx
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / local config
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.nyc_output/

# Planning docs are kept local, out of the repo
docs/
