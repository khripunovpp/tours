# Never write a range back into a manifest — `pnpm add x` must record the exact
# version it resolved. Ranges let two installs a month apart produce different
# trees; see scripts/pin-versions.mjs.
save-exact=true

# Refuse to install under a Node/pnpm the repo does not claim to support,
# rather than failing later with a confusing error.
engine-strict=true

# Fail instead of silently rewriting the lockfile in CI-like runs.
prefer-frozen-lockfile=true
