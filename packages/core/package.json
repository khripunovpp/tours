{
  "name": "@tours/core",
  "version": "0.3.0",
  "description": "Framework-agnostic product tour player, picker and triggers. Renders in shadow DOM, no runtime dependencies.",
  "license": "MIT",
  "author": "Pavel Khripunov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khripunovpp/tours.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/khripunovpp/tours/tree/main/packages/core#readme",
  "bugs": "https://github.com/khripunovpp/tours/issues",
  "keywords": [
    "tours",
    "onboarding",
    "product-tour",
    "walkthrough",
    "guided-tour"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@tours/schema": "workspace:*"
  }
}
